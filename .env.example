# Signs the cart cookie. Set the same value on every instance so a cart
# survives a request landing on a different one.
#
#   fly secrets set CART_SECRET=$(openssl rand -hex 32)
#   render: put the same value in the environment variables
#
# If it is not set, a development fallback is used, which is fine locally but
# means carts are not shared between instances.
CART_SECRET=

# Where the resized-image cache is written. Point it at a persistent volume
# if you want the cache to survive restarts; the default is inside the
# container's filesystem, and the app falls back to the temp directory when
# that is read-only.
IMG_CACHE_DIR=

# How many mirrored pages to keep in memory. Each is ~900 KB, so the default
# of 40 costs about 36 MB.
HTML_CACHE_MAX=40

# libvips concurrency for image resizing. Lower means less memory.
SHARP_CONCURRENCY=2
